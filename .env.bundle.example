# .env.bundle.example
#
# Sample env for docker-compose.bundle.yml. Copy to .env.bundle and edit
# any values you want to change.
#
#   cp .env.bundle.example .env.bundle
#   docker compose -f docker-compose.bundle.yml --env-file .env.bundle up -d
#
# All values below are defaults and can be omitted; the compose file
# falls back to them via ${VAR:-default}. Keeping them here documents
# the surface and lets reviewers see at a glance what the bundle exposes.

# Image tags pulled from ghcr.io/frapercan/*.
# Use `latest` for main / release builds, `develop` for the rolling
# develop-branch build. See docker/README.md for the full tag table.
PROTEA_IMAGE_TAG=latest
PROTEA_FRONTEND_TAG=latest

# Postgres.
POSTGRES_USER=protea
POSTGRES_PASSWORD=protea
POSTGRES_DB=protea
POSTGRES_PORT=5432

# RabbitMQ. Management UI on RABBITMQ_MGMT_PORT (default 15672).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# PROTEA API.
PROTEA_API_PORT=8000
PROTEA_ADMIN_TOKEN=protea-admin
PROTEA_ALLOWED_ORIGINS=http://localhost:3000

# Web frontend.
PROTEA_WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api-proxy
