# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# Coverage
.coverage
htmlcov/

# Docs build
docs/build/
docs/_build/

# IDE
.idea/
.vscode/

# Node
node_modules/
.next/

# Misc
*.log
logs/

.claude/

# Local data
static/
storage/
!protea/infrastructure/storage/

# Large embedding caches and test artifacts
data/ref_cache/
apps/web/test-results/

# Local run outputs (per-run dumps, model checkpoints, eval results)
# Keep curated files under data/benchmarks/ tracked via explicit allow-list.
data/
!data/benchmarks/
!data/benchmarks/**
artifacts/
results/
var/

# Plaintext secret files (D28). Committed encrypted form is
# secrets/*.enc.yaml; the example template (secrets.dev.example.yaml)
# is also tracked.
secrets/secrets.dev.yaml
secrets/secrets.prod.yaml

# Age private keys must never reach the repo. Public keys go in
# .sops.yaml; private keys live in ~/.config/sops/age/keys.txt only.
**/age/keys.txt
*.age.key
sops_age_key.txt

# LibreOffice lock files
.~lock.*

# Coverage XML reports (CI artifacts, not source)
.baseline/

# Local deploy overrides (host-specific secrets, never commit)
.env
.env.local
