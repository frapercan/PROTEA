# Development MinIO for the desktop stack (rootless podman, Quadlet).
#
# Same image and digest as the minio service of docker-compose.yml. Its own
# loopback ports, credentials and data directory; see deploy/dev/README.md.
# The dev bucket must not be called "protea": artifact URIs embed the bucket
# name (s3://<bucket>/<key>), so a dev URI would read as a production one.
[Unit]
Description=PROTEA dev MinIO (API 127.0.0.1:26900, console 127.0.0.1:26901)
PartOf=protea-dev.target
AssertPathIsMountPoint=/srv/protea-dev

[Container]
ContainerName=protea-dev-minio
Image=quay.io/minio/minio@sha256:cf3dadcfa1fb0324f43958bad1abba986d53c4ecc04d4d50b46c7dcda28bd3cd
PublishPort=127.0.0.1:26900:9000
PublishPort=127.0.0.1:26901:9001
Volume=/srv/protea-dev/minio:/data
# The root user is an identifier, not a secret; the password is created once
# from stdin (README) and never appears here or on a command line.
Environment=MINIO_ROOT_USER=protea-dev-root
Secret=protea-dev-minio-root-password,type=env,target=MINIO_ROOT_PASSWORD
Exec=server /data --console-address :9001

[Service]
Slice=protea-dev.slice
MemoryMax=1G
TimeoutStartSec=900
Restart=on-failure
RestartSec=10

[Install]
WantedBy=protea-dev.target
