# Development RabbitMQ for the desktop stack (rootless podman, Quadlet).
#
# Same image and digest as the rabbitmq service of docker-compose.yml. Its
# own loopback ports, credentials, vhost and data directory; see
# deploy/dev/README.md.
[Unit]
Description=PROTEA dev RabbitMQ (4.3.5, AMQP 127.0.0.1:26672, management 127.0.0.1:26673)
PartOf=protea-dev.target
# Same reason as the Postgres unit: never write the broker's state onto the
# root filesystem because the dev volume happened not to be mounted.
AssertPathIsMountPoint=/srv/protea-dev

[Container]
ContainerName=protea-dev-rabbitmq
Image=docker.io/library/rabbitmq:4.3.5-management@sha256:6e83d26931219c9e088e6eefcc877bcca2adc3690c7603f24f4ece8968b13262
# The node is named rabbit@<hostname> and its data directory is keyed by that
# name, so a hostname that changes on recreate orphans the broker's state
# (docker-compose.yml tells the episode). Fixed here for the same reason.
HostName=protea-dev-rabbitmq
PublishPort=127.0.0.1:26672:5672
PublishPort=127.0.0.1:26673:15672
Volume=/srv/protea-dev/rabbitmq:/var/lib/rabbitmq
# Relative to this file, so the configuration is installed with the unit
# rather than read from a checkout that can move under a running broker.
Volume=./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro
# The broker creates this user and this vhost on its first start, and only
# then. The vhost is the dev one, so a dev URL can never name production's.
Environment=RABBITMQ_DEFAULT_USER=protea_dev
Environment=RABBITMQ_DEFAULT_VHOST=protea-dev
# Created once from stdin (README); never in this file, never on argv.
Secret=protea-dev-rabbitmq-password,type=env,target=RABBITMQ_DEFAULT_PASS
StopTimeout=60

[Service]
Slice=protea-dev.slice
# rabbitmq.conf sets the memory watermark under this limit; change both
# together or flow control stops engaging before the kernel kills the broker.
MemoryMax=2G
TimeoutStartSec=900
TimeoutStopSec=90
Restart=on-failure
RestartSec=10

[Install]
WantedBy=protea-dev.target
