# The development web front (Next.js) on 127.0.0.1:26300 (rootless podman, Quadlet).
#
# On the host's network so its server side reaches the dev API on 127.0.0.1:26800,
# and bound to loopback for the same reason the API is: its reads need no
# credential. Exposing it beyond this machine is a separate decision.
[Unit]
Description=PROTEA dev web (Next.js, 127.0.0.1:26300)
PartOf=protea-dev.target
After=protea-dev-api.service
Wants=protea-dev-api.service
AssertPathIsDirectory=%h/protea-dev
# A refusal of the disk gate (exit 78) must not loop: at most three starts
# in fifteen minutes.
StartLimitIntervalSec=900
StartLimitBurst=3

[Container]
ContainerName=protea-dev-web
Image=protea-dev-web.build
Network=host
Environment=HOSTNAME=127.0.0.1
Environment=PORT=26300
Environment=PROTEA_INTERNAL_API_URL=http://127.0.0.1:26800

[Service]
# The disk gate (README, "Disk"): refuses to start below the free-space floor.
ExecStartPre=/bin/bash %h/protea-dev/deploy/PROTEA/deploy/dev/protea-dev-disk-gate.sh %h/protea-dev %n
Slice=protea-dev.slice
MemoryMax=768M
TimeoutStartSec=1800
Restart=on-failure
RestartSec=10

[Install]
WantedBy=protea-dev.target
