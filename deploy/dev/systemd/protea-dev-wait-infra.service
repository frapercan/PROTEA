[Unit]
# Readiness gate for the dev units: blocks until the dev Postgres, RabbitMQ
# and MinIO answer on their loopback ports. The same script as production's
# gate, told the dev ports through the environment.
Description=PROTEA dev infra readiness gate (127.0.0.1:26432, 26672, 26900)
PartOf=protea-dev.target
Wants=protea-dev-postgres.service protea-dev-rabbitmq.service protea-dev-minio.service
After=protea-dev-postgres.service protea-dev-rabbitmq.service protea-dev-minio.service

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=protea-dev.slice
Environment="PROTEA_WAIT_ENDPOINTS=127.0.0.1:26432 127.0.0.1:26672 127.0.0.1:26900"
ExecStart=/bin/bash /srv/protea-dev/deploy/PROTEA/deploy/systemd/protea-wait-infra.sh
TimeoutStartSec=200

[Install]
WantedBy=protea-dev.target
