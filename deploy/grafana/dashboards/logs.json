{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Structured JSON logs from PROTEA api and worker containers, shipped to Loki via the loki-docker-driver plugin. The dashboard groups by the `service_name` label that the driver injects so api, worker-jobs, worker-embeddings, etc. are individually selectable.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "protea-loki" },
      "description": "Live tail of structured JSON log lines from all PROTEA services. Filter with the `service` variable above to focus on api, worker-jobs, worker-embeddings, etc.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "protea-loki" },
          "editorMode": "code",
          "expr": "{compose_project=\"protea\", service_name=~\"$service\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "PROTEA log stream",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "protea-loki" },
      "description": "Counts log lines per service over time. Useful for spotting traffic spikes or a worker that has gone silent.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "protea-loki" },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({compose_project=\"protea\", service_name=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log lines per service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "protea-loki" },
      "description": "Counts ERROR-level log lines per service. Any persistent rate above zero is worth investigating; this is the primary alerting signal once Alertmanager wiring lands in F-OPS.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "protea-loki" },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({compose_project=\"protea\", service_name=~\"$service\"} | json | level=\"ERROR\" [$__interval]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error rate per service",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["protea", "loki", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "protea-loki" },
        "definition": "label_values({compose_project=\"protea\"}, service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{compose_project=\"protea\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "PROTEA / Logs (Loki)",
  "uid": "protea-logs",
  "version": 1,
  "weekStart": ""
}
