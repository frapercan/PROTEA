  "description": "RabbitMQ queue depth, message rates and consumer counts for the protea.* queues (ping, jobs, embeddings, embeddings.batch, embeddings.write, predictions, predictions.batch, predictions.write, evaluations, training). Targets the rabbitmq_exporter metric names so the dashboard works out of the box once the exporter is added to the monitoring compose file.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
      "description": "Ready messages waiting in each protea.* queue.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
          "editorMode": "code",
          "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\"protea\\\\..*\"})",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ready (queued) messages",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
      "description": "Unacknowledged (in-flight) messages per queue.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
          "editorMode": "code",
          "expr": "sum by (queue) (rabbitmq_queue_messages_unacknowledged{queue=~\"protea\\\\..*\"})",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Unacked (in-flight) messages",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
      "description": "Publish and deliver rates per queue, computed from the exporter counters.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "mps"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
          "editorMode": "code",
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_published_total{queue=~\"protea\\\\..*\"}[$__rate_interval]))",
          "legendFormat": "publish {{queue}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
          "editorMode": "code",
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_delivered_total{queue=~\"protea\\\\..*\"}[$__rate_interval]))",
          "legendFormat": "deliver {{queue}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Publish vs deliver rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
      "description": "Consumers attached per queue. Drops to zero indicate a worker outage.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "color-text" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "protea-prometheus" },
          "editorMode": "code",
          "expr": "sum by (queue) (rabbitmq_queue_consumers{queue=~\"protea\\\\..*\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{queue}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Consumers per queue",
      "type": "table"
    }
  ],
